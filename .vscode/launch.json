{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GUI: Audio Analysis Monitor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/gui/main_gui.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Test: Streaming Pipeline",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "-s",
                "tests/test_audio_sources_analysis.py::test_local_file_streaming_pipeline"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
